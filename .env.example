# Supabase session pooler (port 5432, never 6543). App role, not the superuser.
DATABASE_URL=postgresql://medora_app.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Admin URL used only by migrations (postgres.[PROJECT-REF] user).
MIGRATION_DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Password set for the medora_app role by the first migration.
MEDORA_APP_PASSWORD=change-me

# Any OpenAI-compatible provider (Groq, OpenRouter, Gemini OpenAI endpoint, ...). Empty key = fail closed to review.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=
VISION_MODEL=
# Optional: a separate provider for vision, e.g. https://generativelanguage.googleapis.com/v1beta/openai/ for Gemini.
VISION_BASE_URL=
VISION_API_KEY=
ASR_BASE_URL=https://api.groq.com/openai/v1
ASR_API_KEY=
ASR_MODEL=whisper-large-v3
# live = call provider and record, replay = serve recordings only (fails on miss)
MEDORA_LLM_MODE=live

JWT_SECRET=change-me-to-a-random-string-of-32-or-more-chars
UPLOAD_DIR=./uploads
API_URL=http://127.0.0.1:8000
# Set to 1 when served over HTTPS (hosted deploy).
COOKIE_SECURE=0
# Where the web app is served from (CORS).
WEB_ORIGIN=http://localhost:3000
